{
	"name": "jwt-decoder",
	"displayName": "jwt-decoder",
	"description": "A simple JWT decoder extension for VS Code",
	"icon": "images/icon.png",
	"publisher": "jflbr",
	"version": "1.3.0",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "extension.jwt-decoder",
				"title": "JWT Decoder"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/glob": "^8.1.0",
		"@types/mocha": "^10.0.9",
		"@types/node": "^20.17.10",
		"@types/vscode": "^1.85.0",
		"@vscode/test-electron": "^2.4.1",
		"glob": "^13.0.0",
		"mocha": "^10.8.2",
		"typescript": "^5.7.2"
	},
	"repository": {
		"url": "https://github.com/jflbr/jwt-decoder.git",
		"type": "git"
	},
	"homepage": "https://github.com/jflbr/jwt-decoder/blob/master/README.MD"
}
